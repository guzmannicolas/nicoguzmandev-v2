---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'NicoGuzman.dev | Digitalización de Negocios · Webs, WhatsApp con IA y Sistemas',
  description = 'Dejá de perder tiempo y clientes. Páginas web listas en 48 hs, bots de WhatsApp que atienden y cobran las 24 hs y sistemas a medida en Argentina.'
} = Astro.props;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#5956E9" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://v2.nicoguzmandev.com" />
    <meta property="og:locale" content="es_AR" />

    <!-- Google Fonts: Poppins (Headings) + DM Sans (Body) as in Dr.Nube -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Poppins:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-white text-[#27272E] antialiased selection:bg-[#5956E9] selection:text-white overflow-x-hidden">
    <!-- Top Scroll Progress Bar -->
    <div class="fixed top-0 left-0 right-0 z-[60] h-1 bg-transparent pointer-events-none">
      <div
        id="scroll-progress-bar"
        class="h-full bg-gradient-to-r from-[#5956E9] via-[#FAB8C4] to-[#FFDC60] w-0 transition-[width] duration-75"
      ></div>
    </div>

    <slot />

    <!-- Floating WhatsApp Pill Action -->
    <a
      href="https://wa.me/5491100000000?text=Hola%20Nico!%20Vi%20tu%20web%20y%20quiero%20consultar%20para%20digitalizar%20mi%20negocio."
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Consultar por WhatsApp"
      class="fixed bottom-6 right-6 z-50 flex items-center gap-3 rounded-full bg-[#27272E] px-5 py-3.5 text-sm font-semibold text-white shadow-drnube-float transition-all duration-300 hover:-translate-y-1 hover:bg-[#5956E9]"
    >
      <span class="relative flex h-2.5 w-2.5">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-emerald-400"></span>
      </span>
      <span>WhatsApp Directo</span>
    </a>

    <!-- Dr.Nube Scroll Engine:
         1. IntersectionObserver for [data-dr-anim], .dr-assembly-stage, and .title-mask-container (re-triggers on scroll up/down like AOS)
         2. Rellax-style continuous scroll parallax for [data-parallax-speed] and [data-parallax-x]
         3. Animated number counters [data-count-to] when entering viewport
    -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        // 1. Scroll Reveal & Multi-Piece UI Assembly Observer
        const initObserver = () => {
          const animatedNodes = document.querySelectorAll(
            '[data-dr-anim], .dr-assembly-stage, .title-mask-container, .reveal-up'
          );

          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-inview', 'is-visible');
                } else if (entry.boundingClientRect.top > 0) {
                  // When scrolling back up above the element, reset so it animates again on scroll down (like Dr.Nube AOS)
                  entry.target.classList.remove('is-inview', 'is-visible');
                }
              });
            },
            { threshold: 0.14, rootMargin: '0px 0px -45px 0px' }
          );

          animatedNodes.forEach((node) => observer.observe(node));
        };

        // Run initially and after React hydration
        initObserver();
        setTimeout(initObserver, 350);
        setTimeout(initObserver, 1000);

        // 2. Number Counter Observer
        const counterObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              const el = entry.target;
              if (entry.isIntersecting && !el.dataset.counted) {
                el.dataset.counted = 'true';
                const target = parseFloat(el.dataset.countTo || '0');
                const prefix = el.dataset.countPrefix || '';
                const suffix = el.dataset.countSuffix || '';
                const decimals = parseInt(el.dataset.countDecimals || '0', 10);
                const duration = 1100;
                const start = performance.now();

                const step = (now) => {
                  const progress = Math.min((now - start) / duration, 1);
                  const eased = 1 - Math.pow(1 - progress, 3);
                  const current = (target * eased).toFixed(decimals);
                  el.textContent = `${prefix}${current}${suffix}`;
                  if (progress < 1) {
                    requestAnimationFrame(step);
                  }
                };
                requestAnimationFrame(step);
              } else if (!entry.isIntersecting && entry.boundingClientRect.top > 0) {
                delete el.dataset.counted;
              }
            });
          },
          { threshold: 0.3 }
        );

        const bindCounters = () => {
          document.querySelectorAll('[data-count-to]').forEach((el) => counterObserver.observe(el));
        };
        bindCounters();
        setTimeout(bindCounters, 500);

        // 3. Continuous Rellax & simpleParallax Scroll Loop
        const progressBar = document.getElementById('scroll-progress-bar');
        let ticking = false;

        const updateParallax = () => {
          const scrollY = window.scrollY;
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          if (progressBar && docHeight > 0) {
            const pct = Math.min(100, Math.max(0, (scrollY / docHeight) * 100));
            progressBar.style.width = `${pct}%`;
          }

          // Vertical & Horizontal Rellax elements
          document.querySelectorAll('[data-parallax-speed]').forEach((el) => {
            const speed = parseFloat(el.getAttribute('data-parallax-speed') || '0');
            const speedX = parseFloat(el.getAttribute('data-parallax-x') || '0');
            const rotateSpeed = parseFloat(el.getAttribute('data-parallax-rotate') || '0');
            const rect = el.getBoundingClientRect();
            const centerOffset = rect.top + rect.height / 2 - window.innerHeight / 2;

            const yOffset = centerOffset * speed * -0.18;
            const xOffset = centerOffset * speedX * -0.15;
            const rot = centerOffset * rotateSpeed * 0.02;

            el.style.transform = `translate3d(${xOffset.toFixed(1)}px, ${yOffset.toFixed(1)}px, 0) rotate(${rot.toFixed(1)}deg)`;
          });

          ticking = false;
        };

        window.addEventListener(
          'scroll',
          () => {
            if (!ticking) {
              window.requestAnimationFrame(updateParallax);
              ticking = true;
            }
          },
          { passive: true }
        );

        updateParallax();
      });
    </script>
  </body>
</html>
