---
const navLinks = [
  { label: 'Webs Rápidas', href: '#showroom-webs' },
  { label: 'WhatsApp con IA', href: '#automatizacion-ia' },
  { label: 'Sistemas', href: '#sistemas-erp' },
  { label: 'Precios', href: '#planes' },
];
---

<header
  id="main-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-white/85 backdrop-blur-lg border-b border-slate-100"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 sm:px-8 lg:px-10">
    <!-- Brand Logo -->
    <a href="#" class="group flex items-center gap-2 focus:outline-none">
      <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-[#5956E9] text-white font-heading font-bold text-lg shadow-md shadow-[#5956E9]/25 transition-transform duration-300 group-hover:scale-105">
        NG
      </div>
      <div class="flex flex-col">
        <div class="flex items-center gap-1.5">
          <span class="font-heading text-xl font-bold tracking-tight text-[#27272E]">nicoguzman</span>
          <span class="rounded-md bg-[#EBEAFB] px-1.5 py-0.5 font-heading text-xs font-bold text-[#5956E9]">.dev</span>
        </div>
        <span class="text-[11px] font-medium text-[#999FAE] -mt-0.5">Digitalización para Negocios</span>
      </div>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden lg:flex items-center gap-8">
      {navLinks.map((item) => (
        <a
          href={item.href}
          class="text-[15px] font-semibold text-[#525260] transition-colors duration-200 hover:text-[#5956E9]"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Right CTA -->
    <div class="hidden sm:flex items-center gap-3">
      <a
        href="https://templates.nicoguzmandev.com"
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full bg-[#F6F8FF] px-4 py-2.5 text-sm font-semibold text-[#5956E9] transition-all duration-200 hover:bg-[#EBEAFB]"
      >
        8 Demos en Vivo
      </a>
      <a
        href="#planes"
        class="rounded-full bg-[#5956E9] px-6 py-2.5 text-sm font-semibold text-white shadow-md shadow-[#5956E9]/30 transition-all duration-300 hover:-translate-y-0.5 hover:bg-[#4441C8]"
      >
        Quiero Digitalizarme
      </a>
    </div>

    <!-- Mobile Menu Toggle Button -->
    <button
      id="mobile-menu-btn"
      type="button"
      aria-label="Abrir menú"
      class="lg:hidden flex items-center gap-1.5 rounded-full bg-[#F6F8FF] px-3.5 py-2 text-xs font-bold text-[#27272E] border border-slate-200"
    >
      <span>Menú</span>
      <span class="text-[#5956E9]">▾</span>
    </button>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden border-b border-slate-100 bg-white/95 backdrop-blur-xl px-5 py-6 space-y-4"
  >
    <div class="flex flex-col space-y-3">
      {navLinks.map((item) => (
        <a
          href={item.href}
          class="mobile-nav-link text-base font-semibold text-[#27272E] hover:text-[#5956E9]"
        >
          {item.label}
        </a>
      ))}
      <a
        href="https://templates.nicoguzmandev.com"
        target="_blank"
        rel="noopener noreferrer"
        class="mobile-nav-link text-base font-semibold text-[#5956E9]"
      >
        Ver 8 Demos en Vivo ↗
      </a>
    </div>
    <div class="pt-4 border-t border-slate-100">
      <a
        href="#planes"
        class="mobile-nav-link block w-full rounded-full bg-[#5956E9] py-3 text-center text-sm font-bold text-white shadow-md"
      >
        Quiero Digitalizarme
      </a>
    </div>
  </div>
</header>

<script is:inline>
  const header = document.getElementById('main-header');
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      header?.classList.add('shadow-xs', 'border-slate-100');
    } else {
      header?.classList.remove('shadow-xs', 'border-slate-100');
    }
  });

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
    });
  });
</script>
