---
import BrandLogo from './BrandLogo.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { label: 'Inicio', href: '/' },
  { label: 'Servicios', href: '/servicios' },
  { label: 'Templates', href: '/templates' },
  { label: 'Precios', href: '/precios' },
  { label: 'FAQ', href: '/faq' },
  { label: 'Contacto', href: '/contacto' },
];
---

<header
  id="main-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-white/90 backdrop-blur-md border-b border-slate-100"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 sm:px-8 lg:px-10">
    <!-- Brand Logo -->
    <a href="/" class="focus:outline-none">
      <BrandLogo />
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden lg:flex items-center gap-7">
      {navLinks.map((item) => {
        const isActive = currentPath === item.href;
        return (
          <a
            href={item.href}
            class={`text-[14px] font-semibold transition-colors duration-200 ${
              isActive
                ? 'text-[#5956E9] font-bold'
                : 'text-[#525260] hover:text-[#5956E9]'
            }`}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Right CTA -->
    <div class="hidden sm:flex items-center gap-3">
      <a
        href="https://wa.me/5491100000000?text=Hola%20Nico!%20Quiero%20consultar%20para%20digitalizar%20mi%20negocio."
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full bg-[#F6F8FF] px-4 py-2.5 text-xs font-semibold text-[#5956E9] transition-all duration-200 hover:bg-[#EBEAFB]"
      >
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
        </span>
        <span>WhatsApp Directo</span>
      </a>
      <a
        href="/precios"
        class="rounded-full bg-[#5956E9] px-5 py-2.5 text-xs font-bold text-white shadow-md shadow-[#5956E9]/30 transition-all duration-300 hover:-translate-y-0.5 hover:bg-[#4441C8]"
      >
        Ver Planes
      </a>
    </div>

    <!-- Mobile Menu Toggle Button -->
    <button
      id="mobile-menu-btn"
      type="button"
      aria-label="Abrir menú"
      class="lg:hidden flex items-center gap-1.5 rounded-full bg-[#F6F8FF] px-3.5 py-2 text-xs font-bold text-[#27272E] border border-slate-200"
    >
      <span>Menú</span>
      <svg class="w-3.5 h-3.5 text-[#5956E9]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
      </svg>
    </button>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden border-b border-slate-100 bg-white/95 backdrop-blur-xl px-5 py-6 space-y-4"
  >
    <div class="flex flex-col space-y-3">
      {navLinks.map((item) => {
        const isActive = currentPath === item.href;
        return (
          <a
            href={item.href}
            class={`mobile-nav-link text-base font-semibold ${
              isActive ? 'text-[#5956E9] font-bold' : 'text-[#27272E] hover:text-[#5956E9]'
            }`}
          >
            {item.label}
          </a>
        );
      })}
    </div>
    <div class="pt-4 border-t border-slate-100 flex flex-col gap-2">
      <a
        href="/precios"
        class="mobile-nav-link block w-full rounded-full bg-[#5956E9] py-3 text-center text-sm font-bold text-white shadow-md"
      >
        Ver Planes & Precios
      </a>
      <a
        href="https://wa.me/5491100000000?text=Hola%20Nico!%20Quiero%20consultar%20para%20digitalizar%20mi%20negocio."
        target="_blank"
        rel="noopener noreferrer"
        class="mobile-nav-link block w-full rounded-full bg-[#F6F8FF] py-2.5 text-center text-xs font-semibold text-[#5956E9]"
      >
        Consultar por WhatsApp
      </a>
    </div>
  </div>
</header>

<script is:inline>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });

    const links = menu.querySelectorAll('.mobile-nav-link');
    links.forEach((l) => {
      l.addEventListener('click', () => menu.classList.add('hidden'));
    });
  }
</script>
