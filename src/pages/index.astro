---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroTilt from '../components/HeroTilt.tsx';
import BigMetricBanner from '../components/BigMetricBanner.astro';
import HomePillars from '../components/HomePillars.tsx';
import LiveInteractiveChat from '../components/LiveInteractiveChat.tsx';
import CtaFooter from '../components/CtaFooter.astro';
---

<Layout
  title="NicoGuzman.dev | Digitalización de Negocios · Webs, WhatsApp con IA y Sistemas"
  description="Páginas web listas en 48 hs, bots de WhatsApp que atienden y cobran las 24 hs y sistemas simples para comercios y profesionales en Argentina."
>
  <Header currentPath="/" />
  <main>
    <HeroTilt client:load />
    <BigMetricBanner />
    <HomePillars client:visible />
    <LiveInteractiveChat client:visible />
    <CtaFooter />
  </main>
</Layout>
